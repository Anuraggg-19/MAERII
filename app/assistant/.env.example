# Copy these settings into the project .env. Never commit actual keys.
# This is an independent assistant configuration, not the primary LLM order.
ASSISTANT_ENABLED=false
# Set true ONLY after confirming free/trial accounts have no paid overage.
ASSISTANT_TRIAL_CONFIRMED=false
# Reuses GEMINI_API_KEY unless this separate assistant key is provided.
ASSISTANT_GEMINI_API_KEY=
SARVAM_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_SPEECH_MODEL=bulbul:v3
ASSISTANT_SPEECH_VOICE=shubh
ASSISTANT_DAILY_GENERATIONS=20
ASSISTANT_TRIAL_DAILY_CALLS=100
ASSISTANT_TRIAL_DAILY_CHARACTERS=10000
# Set true when serving over HTTPS. Local HTTP testing requires false.
ASSISTANT_SECURE_COOKIE=false

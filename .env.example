# ── Neo4j Aura ──────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# ── API Keys ────────────────────────────────────────────────────────────────
SERPER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

SERPER_API_KEY=
# ── LLM Settings ────────────────────────────────────────────────────────────
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_MODELS=gemini-3.6-flash


# Primary MAERII LLM: Ollama running GPT-OSS on the high-end system.
LLM_PROVIDER_ORDER=local
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=gpt-oss:120b
LOCAL_LLM_TIMEOUT_SECONDS=600
LOCAL_LLM_REASONING_EFFORT=medium

# Google Gemini API Key (for LLM extraction)
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Gemini is the primary LLM. Groq is used only when a key and one or more
# model IDs are configured. Leave GROQ_MODELS empty to disable that fallback.
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_MODELS=gemini-3.6-flash
# ── Market Comparison ──────────────────────────────────────────────────────
MARKET_COMPARISON_MODE=true
MARKET_COMPARISON_DESTINATION_LIMIT=5
MARKET_COMPARISON_DESTINATION_DYNAMIC=true
SCRAPINGDOG_API_KEY=
MARKET_COMPARISON_STORE_RAW=false
# Local, explainable comparison labels. Raw provider results remain in every
# saved comparison regardless of this setting.
MARKET_COMPARISON_RELEVANCE_FILTER=true

# ── Open-Source Discovery ──────────────────────────────────────────────────
OPEN_SOURCE_DISCOVERY_PROVIDER=searxng
OPEN_SOURCE_MARKET_MODE=true
SEARXNG_BASE_URL=http://localhost:8080

# ── Ollama (local LLM, optional) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── ScrapingDog ────────────────────────────────────────────────────────────
SCRAPINGDOG_API_KEY=
# Copy this file to .env and fill in your API keys

# Serper.dev API Key (for web search)
# Get it at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key

# Optional side-by-side Google Shopping comparison. This never changes the
# normal Serper-backed market endpoint.
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key
MARKET_COMPARISON_MODE=false
MARKET_COMPARISON_STORE_RAW=false
# Local, explainable comparison labels. Raw provider results remain in every
# saved comparison regardless of this setting.
MARKET_COMPARISON_RELEVANCE_FILTER=true
# Maximum Scrapingdog Shopping products to enrich through the Google immersive
# product endpoint and then scrape at the retailer destination page. The
# candidate limit prevents repeated failed lookups from consuming unbounded credits.
MARKET_COMPARISON_DESTINATION_LIMIT=5
MARKET_COMPARISON_DESTINATION_CANDIDATE_LIMIT=15
MARKET_COMPARISON_DESTINATION_DYNAMIC=true

# Optional fully open-source market experiment. It is isolated from the normal
# Serper/Gemini workflow. Run SearXNG and Ollama locally before enabling it.
OPEN_SOURCE_MARKET_MODE=false
OPEN_SOURCE_DISCOVERY_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OPEN_SOURCE_RESULTS_PER_QUERY=5
OPEN_SOURCE_MAX_URLS=18
OPEN_SOURCE_MAX_CLASSIFICATIONS=20
OPEN_SOURCE_CLASSIFICATION_BATCH_SIZE=3
OPEN_SOURCE_REQUEST_TIMEOUT_SECONDS=45

# Google Gemini API Key (for LLM extraction)
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
TOGETHER_API_KEY=

# Gemini is the primary LLM. Groq is used only when a key and one or more
# model IDs are configured. Leave GROQ_MODELS empty to disable that fallback.
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_MODELS=gemini-3.6-flash
GROQ_MODELS=

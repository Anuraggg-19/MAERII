# Copy this file to .env and fill in your API keys

# Serper.dev API Key (for web search)
# Get it at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key

# Google Gemini API Key (for LLM extraction)
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
TOGETHER_API_KEY=

# Gemini is the primary LLM. Groq is used only when a key and one or more
# model IDs are configured. Leave GROQ_MODELS empty to disable that fallback.
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_MODELS=gemini-3.6-flash
GROQ_MODELS=

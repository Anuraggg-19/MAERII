// -- STEP 1: New constraints for market nodes --
CREATE CONSTRAINT IF NOT EXISTS FOR (n:MarketProduct) REQUIRE n.product_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Seller) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Platform) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:MarketAttribute) REQUIRE n.name IS UNIQUE;


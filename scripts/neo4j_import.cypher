// =============================================================
// MAERII Raw Material Knowledge Engine — Neo4j Import Script
// Generated from 87 MFP items and 1259 relationship edges
// =============================================================

// -- STEP 0: Clear existing data (run this ONCE on a fresh DB) --
MATCH (n) DETACH DELETE n;

// -- STEP 1: Create constraints and indexes --
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Material) REQUIRE n.mfp_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:State) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Skill) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Product) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:MaterialGroup) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:District) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Cluster) REQUIRE n.name IS UNIQUE;

// -- STEP 2: Create Material nodes --
CREATE (:Material {mfp_id: 1, name: 'Tamarind (with seeds)', scientific_name: 'Tamarindus indica', category: 'Forest Produce', msp: 36.0, unit: 'kg', description: 'Tamarind is a leguminous tree bearing edible fruit, indigenous to tropical Africa and naturalized in Asia. It produces pods with a unique sweet and sour taste, playing a central role in Indian cuisine and offering versatile uses.', season: 'March-April', shelf_life: '9-12 months', availability_band: 'medium'});
CREATE (:Material {mfp_id: 2, name: 'Wild Honey', scientific_name: '', category: 'Forest Produce', msp: 225.0, unit: 'kg', description: 'Wild honey is a raw, natural sweetener collected by tribal communities from natural bee hives in forests. Untouched by chemicals, it is valued for its medicinal properties and supports tribal livelihoods.', season: '', shelf_life: '12 months', availability_band: 'medium'});
CREATE (:Material {mfp_id: 3, name: 'Gum Karaya', scientific_name: 'Sterculia urenus', category: 'Forest Produce', msp: 114.0, unit: 'kg', description: 'Gum Karaya is a natural gum exuded from the Sterculia urens tree, primarily found in India. It is economically important for forest-dwelling tribal communities who collect it, and is widely used as an emulsifier, stabilizer, and thickener in various industries.', season: 'November-June', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 4, name: 'Karanj seed', scientific_name: 'Pongamia pinnata', category: 'Forest Produce', msp: 22.0, unit: 'kg', description: 'Karanj seed, derived from the Pongamia pinnata tree, is a valuable forest produce known for its high oil content (30-45%). This oil has diverse applications, ranging from traditional medicinal uses and insect repellents to modern biofuel production.', season: 'February-May', shelf_life: '2 months', availability_band: 'medium'});
CREATE (:Material {mfp_id: 5, name: 'Sal seed', scientific_name: 'Shorearobusta', category: 'Forest Produce', msp: 20.0, unit: 'kg', description: 'Sal seed is an important non-timber forest product, primarily valued for its oil, which supports the livelihoods of many forest dwellers in India. It is collected by tribal communities to supplement their incomes.', season: 'May-June', shelf_life: '', availability_band: 'medium'});
CREATE (:Material {mfp_id: 6, name: 'Mahua seed', scientific_name: 'Madhuca longifolia', category: 'Forest Produce', msp: 29.0, unit: 'kg', description: 'Mahua seeds are oil-rich seeds from the Madhuca longifolia tree, highly valued for their economic importance as a source of edible fats and oil, and are integral to tribal livelihoods.', season: 'May-July', shelf_life: '', availability_band: 'medium'});
CREATE (:Material {mfp_id: 7, name: 'Sal leaves', scientific_name: 'Shorearobusta', category: 'Forest Produce', msp: 35.0, unit: 'kg', description: 'Sal leaves are an important Non-Timber Forest Produce, especially for tribal communities in India, providing livelihoods through their use in making eco-friendly plates and containers.', season: '', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 8, name: 'Chironji pods with seeds', scientific_name: 'Buchananialanzan', category: 'Forest Produce', msp: 126.0, unit: 'kg', description: 'Chironji (Buchanania lanzan) is an underutilized nut-bearing tree native to the Indian subcontinent, valued for its nutritional and palatable edible seed kernels, often used as an almond substitute in confectionery. It holds significant importance for tribal communities who harvest it from tropical ', season: 'April-June', shelf_life: '', availability_band: 'medium'});
CREATE (:Material {mfp_id: 9, name: 'Myrobalan', scientific_name: 'Terminalia chebula', category: 'Forest Produce', msp: 15.0, unit: 'kg', description: 'Myrobalan (Terminalia chebula), also known as Haritaki, is a medium to large deciduous tree native to India. Its dried fruit is highly valued in traditional Ayurvedic medicine for its therapeutic properties, including antioxidant and anti-inflammatory potential, and is also an excellent source of ta', season: 'February-August', shelf_life: '24 months', availability_band: 'medium'});
CREATE (:Material {mfp_id: 10, name: 'Rangeeni Lac', scientific_name: 'Kerria lacca', category: 'Forest Produce', msp: 200.0, unit: 'kg', description: 'Rangeeni Lac is a natural resin secreted by the Kerria lacca insect, primarily cultivated on specific host trees. It is a crucial forest produce that supports the livelihoods of millions of tribal and forest-dependent families in India.', season: 'May-June & October-November', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 11, name: 'Kusumi Lac', scientific_name: 'Kerria lacca', category: 'Forest Produce', msp: 275.0, unit: 'kg', description: 'Kusumi Lac is a natural resin secreted by the Kerria lacca insect, a scale insect. It is a bivoltine strain, cultivated on specific host plants, and serves as a vital source of income for rural and tribal communities in India.', season: '', shelf_life: '', availability_band: 'medium'});
CREATE (:Material {mfp_id: 12, name: 'Kusum seeds', scientific_name: 'Schleicheraoleosa', category: 'Forest Produce', msp: 23.0, unit: 'kg', description: 'Kusum seeds are derived from the multipurpose Schleichera oleosa tree, known for its oil-producing nature. The oil is traditionally used for hair care, Ayurvedic treatments, and has applications in various industries.', season: 'September-November', shelf_life: '', availability_band: 'medium'});
CREATE (:Material {mfp_id: 13, name: 'Neem seeds', scientific_name: 'Azadirachta indica', category: 'Forest Produce', msp: 27.0, unit: 'kg', description: 'Neem seeds are the source of neem oil and are processed into bioactive products for pest and disease management due to their high azadirachtin content. They are also widely used in medicinal treatments.', season: '', shelf_life: '4 months', availability_band: 'medium'});
CREATE (:Material {mfp_id: 14, name: 'Puwad seeds', scientific_name: 'Cassia tora', category: 'Forest Produce', msp: 16.0, unit: 'kg', description: 'Puwad seeds, also known as Cassia Tora, are hard, small seeds from a leguminous annual herb found in tropical regions of India. They are naturally sourced from forests and are rich in natural polymers and soluble fiber, making them versatile raw materials for various industries.', season: 'November-December', shelf_life: '2 years', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 15, name: 'Baheda', scientific_name: 'Terminalia bellirica', category: 'Forest Produce', msp: 17.0, unit: 'kg', description: 'Baheda, also known as Bhibhitaki, is a large, fast-growing deciduous tree found throughout India. It is a multipurpose tree valued for its medicinal properties, timber, fodder, and its fruits are a key ingredient in Ayurvedic medicine.', season: '', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 16, name: 'Hill Broom Grass', scientific_name: 'Thysanolaena maxima', category: 'Forest Produce', msp: 50.0, unit: 'kg', description: 'Thysanolaena latifolia, commonly known as tiger grass or broom grass, is primarily valued for its inflorescences, which are harvested to produce durable cleaning tools. It is an important non-timber forest resource that offers sustainable income to tribal communities.', season: 'November-March', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 17, name: 'Dry Shikakai Pods', scientific_name: 'Acacia concinna', category: 'Forest Produce', msp: 50.0, unit: 'kg', description: 'Shikakai pods are the fruit pods of the Acacia concinna tree, widely recognized in India as a natural soap substitute, primarily for hair care. It is a medicinal herb valued for its cleansing, scalp-nourishing, and hair-conditioning properties.', season: 'February-March', shelf_life: '12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 18, name: 'Bael pulp (Dried)', scientific_name: 'Aegle marmelos', category: 'Forest Produce', msp: 30.0, unit: 'kg', description: 'Bael (Aegle marmelos) is a highly valued indigenous Indian fruit known for its medicinal properties, distinctive aroma, and nutritional profile. It holds cultural significance, often planted around temples and used in traditional medicine and rituals.', season: 'July-August', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 19, name: 'Nagarmotha', scientific_name: 'Cyperus rotundas', category: 'Forest Produce', msp: 30.0, unit: 'kg', description: 'Nagarmotha (Cyperus rotundus) is a perennial medicinal herb, widely valued in Indian systems of medicine, especially Ayurveda, for its therapeutic properties supporting digestion, women\'s health, and overall wellness. Its underground rhizomes and roots are the primary harvested parts.', season: '', shelf_life: '12-24 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 20, name: 'Shatavari Roots (Dried)', scientific_name: 'Asparagus racemosus', category: 'Forest Produce', msp: 107.0, unit: 'kg', description: 'Shatavari roots are the underground treasures of Asparagus racemosus, traditionally used in Ayurveda to nourish reproductive health and as a tonic. They are valued for their moisturizing, rejuvenating, and adaptogenic properties.', season: '', shelf_life: '12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 21, name: 'Gudmar/Madhunashini', scientific_name: 'Gymnemasylvestre', category: 'Forest Produce', msp: 41.0, unit: 'kg', description: 'Gudmar, also known as Madhunashini, is an important medicinal climber revered for its anti-diabetic properties and its ability to suppress sweet taste. It is widely used in traditional Indian medicine for various ailments like rheumatism, cough, and ulcers.', season: 'June, October', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 22, name: 'Kalmegh', scientific_name: 'Andrographis paniculata', category: 'Forest Produce', msp: 35.0, unit: 'kg', description: 'Kalmegh is a medicinal herb used in Ayurvedic and Unani systems of medicine for its immunological, antibacterial, and hepatoprotective properties. It is a perennial herb widely cultivated in several countries, including India.', season: 'June-November', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 23, name: 'Tamarind (De-seeded)', scientific_name: 'Tamarindus indica', category: 'Forest Produce', msp: 63.0, unit: 'kg', description: 'Tamarind is a versatile fruit with a unique sweet/sour flavor, used for various purposes, and virtually every part of the tree has some value in commerce.', season: 'March-April', shelf_life: '6 months', availability_band: 'medium'});
CREATE (:Material {mfp_id: 24, name: 'Guggul (exudates)', scientific_name: 'Commiphora wightii', category: 'Forest Produce', msp: 812.0, unit: 'kg', description: 'Guggul is a natural gum resin derived from the mukul myrrh tree, widely recognized in Ayurveda, India\'s traditional herbal medicine. It has been used historically for its medicinal properties.', season: 'February-June', shelf_life: '4-9 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 25, name: 'Mahua Flowers (dried)', scientific_name: 'Madhuca longifolia', category: 'Forest Produce', msp: 30.0, unit: 'kg', description: 'Mahua Flowers are the edible flowers of the Madhuca longifolia tree, used for food, medicine, and as a source of income for tribal communities. They are rich in nutrients, including calcium and iron.', season: 'March-May', shelf_life: '6-12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 26, name: 'Tejpatta (dried)', scientific_name: 'Cinnamomum tamala and Cinnamomum sp.', category: 'Forest Produce', msp: 40.0, unit: 'kg', description: 'Tejpatta, also known as Indian bay leaf, is a multipurpose evergreen plant native to India, used for culinary and medicinal purposes. Its leaves have a clove-like aroma with a hint of peppery taste.', season: 'October-December', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 27, name: 'Jamun dried seeds', scientific_name: 'Syzygiumcumini', category: 'Forest Produce', msp: 42.0, unit: 'kg', description: 'Jamun dried seeds are a potential source of bioactive compounds and have various health benefits, including alleviating Kapha/pitta and boosting the immune system.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'medium'});
CREATE (:Material {mfp_id: 28, name: 'Dried Amla pulp (deseeded)', scientific_name: 'Phyllanthus emblica', category: 'Forest Produce', msp: 52.0, unit: 'kg', description: 'Dried Amla pulp (deseeded) is a forest produce rich in bioactive compounds, used in various traditional and medicinal products. It is a rich source of vitamin C and has antioxidant properties.', season: 'October-January', shelf_life: '6 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 29, name: 'Marking Nut', scientific_name: 'Semecarpus anacardium', category: 'Forest Produce', msp: 9.0, unit: 'kg', description: 'Marking Nut is a deciduous tree that provides food, medicines, oil, and is possibly best known for its use in making a permanent marking ink. It is a multi-purpose tree with various medicinal properties.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 30, name: 'Soap Nut (dried)', scientific_name: 'Sapindusemarginatus', category: 'Forest Produce', msp: 14.0, unit: 'kg', description: 'Soap Nut (dried) is a forest produce used for its natural foaming, cleansing, and exfoliating abilities, making it a valuable resource for the cosmetic industry. It is also used as a cleaning agent and natural shampoo.', season: 'March-April, October-January', shelf_life: '2 years', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 31, name: 'Bhava seed/ (Amaltas)', scientific_name: 'Cassia fistula', category: 'Forest Produce', msp: 13.0, unit: 'kg', description: 'Bhava seed, also known as Amaltas, is a deciduous tree with cascading golden-yellow flowers, and has various health benefits. It is used in herbal medicine and as an ornamental plant.', season: 'Late spring/early summer', shelf_life: '6 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 32, name: 'Arjuna Bark', scientific_name: 'Terminalia arjuna', category: 'Forest Produce', msp: 21.0, unit: 'kg', description: 'Arjuna Bark is the bark of the Terminalia arjuna tree, a large tree common throughout India, renowned for its exceptional healing properties. It is widely used for its medicinal properties, especially its cardiovascular properties.', season: 'December-March', shelf_life: '2 years', availability_band: 'medium'});
CREATE (:Material {mfp_id: 33, name: 'Kokum (Dry)', scientific_name: 'Garcinia indica', category: 'Forest Produce', msp: 29.0, unit: 'kg', description: 'Kokum is a cherry tomato-like fruit with medicinal properties, used as a condiment and for its anti-inflammatory effects. It is native to the Western Ghats of India.', season: 'May-September', shelf_life: '5-15 days', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 34, name: 'Giloe', scientific_name: 'Tinospora cordifolia', category: 'Forest Produce', msp: 40.0, unit: 'kg', description: 'Giloe, also known as Tinospora cordifolia, is a herbaceous vine used in traditional Indian medicine, with diverse health benefits. It is native to India and its root, stems, and leaves are used in Ayurvedic medicine.', season: 'March-September', shelf_life: '24 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 35, name: 'Kaunch seed', scientific_name: 'Mucuna pruriens', category: 'Forest Produce', msp: 21.0, unit: 'kg', description: 'Kaunch seed is a tropical legume used for its medicinal properties, particularly in Ayurveda for enhancing vitality and male reproductive health. It is also valued for its neuroprotective properties.', season: 'Not specified', shelf_life: '24 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 36, name: 'Chirata', scientific_name: 'Swertia chirayita', category: 'Forest Produce', msp: 34.0, unit: 'kg', description: 'Chirata is a medicinal herb used to treat various ailments, and it is a major source of income for rural households in eastern Nepal. The plant is harvested for its medicinal properties and is used in traditional medicine.', season: 'July-October', shelf_life: '1-14 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 37, name: 'Vaybidding/ Vavding', scientific_name: 'Embeliaribes', category: 'Forest Produce', msp: 94.0, unit: 'kg', description: 'Vavding, also known as Embelia ribes, is a climbing shrub with small black berries traditionally used in Ayurvedic and Siddha medicine for various health benefits. It is a crucial ingredient in approximately 75 Ayurvedic formulations.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 38, name: 'Dhavaiphool dried flowers', scientific_name: 'Woodfordiaflobunda', category: 'Forest Produce', msp: 37.0, unit: 'kg', description: 'Dhavaiphool dried flowers, also known as Dhataki, are used in Ayurvedic medicine for their therapeutic values and are a deciduous flowering shrub found in the tropical and subtropical regions of India.', season: 'February-April', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 39, name: 'Nux Vomica', scientific_name: 'Strychnosnux vomica', category: 'Forest Produce', msp: 42.0, unit: 'kg', description: 'Nux Vomica is a deciduous tree native to India and Southeast Asia, known for being the natural source of the extremely poisonous compound strychnine. It is used in traditional medicine and as a source of materials.', season: 'Not specified', shelf_life: '30 weeks', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 40, name: 'Ban Tulsi Leaves (dried)', scientific_name: 'Ocimumtenuiflorum', category: 'Forest Produce', msp: 22.0, unit: 'kg', description: 'Ban Tulsi Leaves are the dried leaves of the Ocimum tenuiflorum plant, renowned for their life-prolonging and rejuvenating properties. They are used in Ayurvedic and folk medicine, as well as in many religious ceremonies.', season: 'March-June', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 41, name: 'Kshirni', scientific_name: 'Hemidesmus indicus', category: 'Forest Produce', msp: 35.0, unit: 'kg', description: 'Kshirni, also known as Indian sarsaparilla, is a species of plant found in South Asia, used in traditional medicine for various health benefits. The root is a substitute for sarsaparilla and is used to make beverages and in traditional medicine.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 42, name: 'Bakul (dried bark)', scientific_name: 'Mimusopselengii', category: 'Forest Produce', msp: 46.0, unit: 'kg', description: 'Bakul is a medium-sized evergreen tree with a thick, dark brownish black or grayish black bark, used for its astringent and tonic properties. It is traditionally used in Ayurveda and folk medicine for various health benefits.', season: 'April-October', shelf_life: '9 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 43, name: 'Kutaj (dried bark)', scientific_name: 'Holarrhenapubescens/ H.aniidysenterical', category: 'Forest Produce', msp: 31.0, unit: 'kg', description: 'Kutaj is a medicinal plant used to treat various diseases such as diarrhea, dysentery, and skin conditions. Its bark is used as an astringent and has been used in traditional Indian medicine for centuries.', season: 'February-March', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 44, name: 'Noni/Aal (dried fruits)', scientific_name: 'Morindacitrifolia', category: 'Forest Produce', msp: 17.0, unit: 'kg', description: 'Noni, also known as Indian mulberry, is a fruit-bearing tree with various medicinal and nutritional values. It is a significant source of phytochemicals with antibacterial, antiviral, and anti-inflammatory properties.', season: 'Year-round', shelf_life: '15-20 days', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 45, name: 'Sonapatha/ Syonak pods', scientific_name: 'Oroxylumindicum', category: 'Forest Produce', msp: 21.0, unit: 'kg', description: 'Sonapatha, also known as Shyonak, is a small perennial tree with medicinal properties, used in Ayurveda to treat various ailments. Its pods, roots, and stem bark are traded and used in traditional medicine.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 46, name: 'Chanothi seeds', scientific_name: 'Abrusprecatorius', category: 'Forest Produce', msp: 45.0, unit: 'kg', description: 'Chanothi seeds are the seeds of the Abrus precatorius plant, a herbaceous flowering plant in the bean family Fabaceae, known for its toxic seeds used as beads and in percussion instruments. The seeds are highly toxic due to the presence of abrin.', season: '', shelf_life: '', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 47, name: 'Kalihari (dried tubers)', scientific_name: 'Gloriosa superba', category: 'Forest Produce', msp: 31.0, unit: 'kg', description: 'Kalihari, also known as Gloriosa superba, is a perennial, climbing plant with medicinal properties, and its tubers are highly valued. It is a highly variable, deciduous, summer-growing tuberous plant from tropical and southern Africa and temperate and tropical Asia.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 48, name: 'Makoi (dried fruits)', scientific_name: 'Solanum nigrum', category: 'Forest Produce', msp: 24.0, unit: 'kg', description: 'Makoi, also known as Solanum nigrum, is a plant used in traditional medicine for its various health benefits, and its fruits and leaves are consumed as food in some parts of India. It is an important plant in traditional medicines belonging to the Solanaceae family.', season: 'November-April', shelf_life: '4-5 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 49, name: 'Apang plant', scientific_name: 'Achyranthes aspera', category: 'Forest Produce', msp: 28.0, unit: 'kg', description: 'Achyranthes aspera, commonly known as Apamarga, is a herbal medicinal plant used traditionally in wound healing, piles, skin diseases, and dental problems. It has various medicinal properties like anticough, antidiarrheal, antipiles, and is considered a lord of all plants.', season: 'Throughout the year', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 50, name: 'Sugandhmantri roots/ tubers', scientific_name: 'Homalomenaaromatica', category: 'Forest Produce', msp: 38.0, unit: 'kg', description: 'Sugandhmantri is a high-valued economic plant known for its medicinal and aromatic character, commonly found in the sub-Himalayan regions of North East India.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 51, name: 'Van Tulsi seeds', scientific_name: 'Ocimumgratissimum', category: 'Forest Produce', msp: 16.0, unit: 'kg', description: 'Van Tulsi seeds are a type of forest produce used for their medicinal and aromatic properties, particularly in traditional Ayurvedic and herbal practices. They are highly valued for their calming and cleansing nature.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 52, name: 'Van Jeera', scientific_name: 'Vernonia anthelmintica', category: 'Forest Produce', msp: 70.0, unit: 'kg', description: 'Van Jeera, also known as Vernonia anthelmintica, is a medicinal plant used in local and traditional medicine to manage various disorders. It is a forest produce with high zinc and chlorine content, used to treat vitiligo and other skin issues.', season: 'September-October', shelf_life: '2 years', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 53, name: 'Tamarind Seed', scientific_name: 'Tamarindus indica', category: 'Forest Produce', msp: 11.0, unit: 'kg', description: 'Tamarind seed is a forest produce obtained from the tamarind tree, used traditionally for various medicinal purposes and as a food additive. It has immense potential as a fruit and condiment.', season: 'March-April', shelf_life: '9-12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 54, name: 'Bamboo Brooms', scientific_name: 'Thysanolaena maxima', category: 'Forest Produce', msp: 60.0, unit: 'kg', description: 'Bamboo Brooms are made from the flowers of the Thysanolaena latifolia plant, which is used as a cleaning tool or broom. It is a type of non-timber forest produce that provides local employment.', season: 'January-March', shelf_life: '2 years', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 55, name: 'Dry Anola', scientific_name: 'Phyllanthus emblica', category: 'Forest Produce', msp: 60.0, unit: 'kg', description: 'Dry Anola, also known as Amla or Indian Gooseberry, is a deciduous shrub or small tree with medicinal uses. It is widely used in alternative medicine, health foods, and herbal products.', season: 'Not specified', shelf_life: '6 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 56, name: 'Kachri Baheda', scientific_name: 'Terminalia bellerica', category: 'Processed', msp: 20.0, unit: 'kg', description: 'Kachri Baheda, also known as Baheda, is a large deciduous tree with medicinal uses, particularly in Ayurvedic medicine. Its fruit is traditionally used in combination with other ingredients for health benefits.', season: 'December-January', shelf_life: '10-15 days', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 57, name: 'Kachri Harra', scientific_name: 'Terminalia chebula', category: 'Processed', msp: 23.0, unit: 'kg', description: 'Kachri Harra, also known as Harad or Chebulic Myrobalan, is a medicinal tree species native to India and other parts of Southeast Asia, valued for its fruit\'s medicinal properties. It is used in traditional medicine to treat various diseases, including constipation, dementia, and diabetes.', season: 'February-March', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 58, name: 'Seed lac', scientific_name: 'Kerria lacca', category: 'Forest Produce / Processed', msp: 677.0, unit: 'kg', description: 'Seed lac is a resinous encrustation formed around the bodies of microscopic lac insects, used to produce various products like shellac and lac dye. It is an important forest produce in India, providing a livelihood for many tribal communities.', season: 'November-December and July-December', shelf_life: '18 months', availability_band: 'medium'});
CREATE (:Material {mfp_id: 59, name: 'Beetal nut raw', scientific_name: 'Areca catechu', category: 'Agriculture', msp: 30.0, unit: 'kg', description: 'Beetal nut, also known as betel nut, is the seed of a palm tree, originally native to the Philippines, with versatile uses and significant economic value. It is a carcinogen when consumed alone, posing health risks such as oral and esophageal cancer.', season: 'Not specified', shelf_life: '7-10 days', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 60, name: 'Beetal nut Dry', scientific_name: 'Areca catechu', category: 'Agriculture / Processed', msp: 200.0, unit: 'kg', description: 'Beetal nut, also known as Areca nut, is sourced from the Areca catechu tree and has various pharmacological uses. It is a seed of a palm belonging to the areca genus.', season: 'March-June', shelf_life: '7-10 days', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 61, name: 'Mushroom (Dry)', scientific_name: 'Agaricusbisporus', category: 'Agriculture / Processed', msp: 300.0, unit: 'kg', description: 'Mushroom is a highly perishable and proteinaceous food product with medicinal properties, used as food and drug in fresh, dried, or canned form.', season: 'Throughout the year', shelf_life: '1-3 days', availability_band: 'low'});
CREATE (:Material {mfp_id: 62, name: 'Black Rice', scientific_name: 'Oryza sativa L', category: 'Agriculture', msp: 100.0, unit: 'kg', description: 'Black rice is a special cultivar of rice containing high anthocyanin pigments, harvested with high moisture content and needs to be dried for safety and extended shelf life.', season: 'Not specified', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 63, name: 'Johar Rice', scientific_name: 'Oryza sativa', category: 'Agriculture', msp: 50.0, unit: 'kg', description: 'Joha Rice is a treasured grain that brings the authentic flavours of Northeast India to every meal, known for its rich nutritional value and unique heritage.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 64, name: 'King Chilli', scientific_name: 'Capsicum chinense Jacq', category: 'Agriculture', msp: 300.0, unit: 'kg', description: 'King Chilli is an exotic crop belonging to the species Capsicum chinense Jacq, cultivated for its spicy and medicinal properties. It is an important crop for tribal communities in northeastern India.', season: 'Not specified', shelf_life: '3-5 days', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 65, name: 'Mustard', scientific_name: 'Brassica nigra', category: 'Agriculture', msp: 40.0, unit: 'kg', description: 'Mustard is a winter annual plant with edible leaves, seeds, flowers, and stems, having a pungent spicy flavor. It is native to Europe, Africa, and Asia.', season: 'October-February', shelf_life: '6 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 66, name: 'Raw Cashew', scientific_name: 'Anacardium occidentale', category: 'Agriculture', msp: 450.0, unit: 'kg', description: 'Cashew is the edible seed of the cashew fruit, native to tropical South America and widely cultivated in India and other tropical regions. It is a significant source of nutrition and income for many communities.', season: 'None specified', shelf_life: '6-12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 67, name: 'Cashew Nut', scientific_name: 'Anacardium occidentale', category: 'Agriculture / Processed', msp: 800.0, unit: 'kg', description: 'Cashew nut is the edible seed of the cashew tree, a tropical evergreen tree native to South America, and is a popular snack and ingredient in various dishes.', season: 'Not specified', shelf_life: '6-12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 68, name: 'Ginger dry', scientific_name: 'Zingiber officinale', category: 'Agriculture / Processed', msp: 50.0, unit: 'kg', description: 'Ginger dry is a processed form of ginger, a tropical perennial plant whose rhizome is widely used as a spice and folk medicine, known for its aroma and pungent flavor.', season: 'March-June', shelf_life: '12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 69, name: 'Perilla', scientific_name: 'Perilla frutescens', category: 'Agriculture', msp: 140.0, unit: 'kg', description: 'Perilla is a traditional crop and an annual herb of the Labiatae family, used for its seeds, oils, and as a source of biologically active antioxidant compounds. It is used in traditional nutritional and medicinal formulations.', season: 'Autumn', shelf_life: 'less than a year', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 70, name: 'Rosella', scientific_name: 'Hibiscus sabdariffa', category: 'Agriculture', msp: 200.0, unit: 'kg', description: 'Rosella is a species of flowering plant used to make tea, jam, and other products, known for its nutritional and medicinal properties.', season: 'March-November', shelf_life: '12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 71, name: 'Nutgall', scientific_name: 'Rhus chinensis', category: 'Agriculture', msp: 150.0, unit: 'kg', description: 'Nutgall is a deciduous shrub or small tree with an open, spreading crown, used for its medicinal properties and as a source of tannins, dye plant, and oil. It is also used to produce an edible fruit.', season: 'Winter', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 72, name: 'Zanthoxylum Dried', scientific_name: 'Zanthoxylum armatum', category: 'Agriculture', msp: 200.0, unit: 'kg', description: 'Zanthoxylum armatum, also known as the \'toothache relieving tree\', is a plant with significant medicinal value, particularly in treating tooth- and gum-related problems. It is a source of the spice Sichuan pepper and is used in folk medicine, essential oil production, and as an ornamental garden pla', season: 'July-August', shelf_life: '2 years', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 73, name: 'Jack Fruit Seed', scientific_name: 'Artocarpus heterophyllus', category: 'Agriculture', msp: 45.0, unit: 'kg', description: 'Jackfruit seed is a byproduct of the jackfruit tree, which is a tropical tree with a large, multiple fruit composed of hundreds to thousands of individual flowers. The seeds are rich in nutrients and have potential uses in food and other products.', season: 'March-June', shelf_life: '2 years', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 74, name: 'Tassar Cocoon (Reeling Class Grade-I / Un-Reeling Class Grade-I)', scientific_name: '', category: 'Forest Produce / Horticulture', msp: 0, unit: 'kg', description: 'Tassar Cocoon is a type of forest produce used for silk production, providing a livelihood option for rural communities. It is an important resource for sericulture.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 75, name: 'Cashes Kernel', scientific_name: 'Anacardium occidentale', category: 'Forest Produce / Processed', msp: 90.0, unit: 'kg', description: 'Cashew kernel is the edible seed of the cashew tree, a tropical evergreen tree native to South America, now widely cultivated in India and other parts of the world. It is a rich source of nutrients and has various uses in food and other products.', season: 'March-June', shelf_life: '4 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 76, name: 'Elephant Apple Dry', scientific_name: 'Dillenia indica', category: 'Forest Produce / Horticulture', msp: 120.0, unit: 'kg', description: 'Elephant Apple Dry is a forest produce derived from the fruit of the Dillenia indica tree, which is native to southeastern Asia and has diverse medicinal uses. It is a vital food source for elephants and has excellent food value.', season: 'December', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 77, name: 'Bamboo Shoot', scientific_name: 'Phyllostachys edulis', category: 'Forest Produce', msp: 70.0, unit: 'kg', description: 'Bamboo shoots are rich in protein, fiber, vitamins, and minerals, and are considered a healthy food. They are harvested from the swollen buds and tender stems of bamboo plants.', season: 'July-August', shelf_life: '2-3 days', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 78, name: 'Malkangni Seed', scientific_name: 'Celastruspaniculatus wild', category: 'Forest Produce', msp: 100.0, unit: 'kg', description: 'Malkangni seed is a forest produce used for its therapeutic benefits, including enhancing memory and cognitive functions. It is also known as Jyotishmati or intellect tree.', season: 'Not specified', shelf_life: '6 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 79, name: 'Mahul Leaves', scientific_name: 'Bauhinia vahlli', category: 'Forest Produce', msp: 15.0, unit: 'kg', description: 'Mahul Leaves are a type of forest produce obtained from the Bauhinia vahlii plant, a vigorous climbing shrub native to central India, and are used for various purposes including food, medicine, and crafts. The plant is harvested from the wild and also cultivated for its fruits and as an ornamental p', season: 'Throughout the year', shelf_life: '6-12 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 80, name: 'Nagod', scientific_name: 'Vitex negundo', category: 'Forest Produce', msp: 20.0, unit: 'kg', description: 'Vitex negundo, also known as Nagod, is a multipurpose shrub with various uses, including traditional medicine, edible seeds, and other commodities. It is widely distributed throughout India and has been used for centuries in folk medicine.', season: 'Not specified', shelf_life: 'Not specified', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 81, name: 'Gokhru', scientific_name: 'Tribulus terrestris', category: 'Forest Produce', msp: 60.0, unit: 'kg', description: 'Gokhru is a valuable medicinal herb used in many nations as an ingredient in food supplements, known for its various medicinal properties. It is a prostrate, spreading annual herb with small yellow flowers.', season: 'April-October', shelf_life: '2 years', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 82, name: 'Pipla/Uchithi (Dried berry)', scientific_name: 'Piper pedicellatum', category: 'Forest Produce', msp: 120.0, unit: 'kg', description: 'Pipla/Uchithi is a dried berry used in various products, providing health benefits and income for rural communities.', season: 'April-June', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 83, name: 'Gamhar/Gamri (Dry bark)', scientific_name: 'Gmelina arborea', category: 'Forest Produce', msp: 20.0, unit: 'kg', description: 'Gamhar/Gamri is a deciduous tree with a wide range of uses, including medicine, timber, and fuel. It is native to India and has potential for agroforestry.', season: 'year-round, but higher production during dry months', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 84, name: 'Oroxylum indicum (Dry bark)', scientific_name: 'Oroxylum indicum', category: 'Forest Produce', msp: 40.0, unit: 'kg', description: 'Oroxylum indicum, also known as the Indian trumpet tree, is a species of flowering plant with various segments used in traditional medicine. It is native to the Indian subcontinent and has edible flower buds, pods, stems, and leaves.', season: '', shelf_life: '', availability_band: 'low'});
CREATE (:Material {mfp_id: 85, name: 'Wild Mushroom Dry', scientific_name: 'Agaricussp', category: 'Forest Produce', msp: 400.0, unit: 'kg', description: 'Wild Mushroom Dry is a type of forest produce collected by tribal communities, it is a dried form of various wild mushrooms.', season: 'March-April, July-August', shelf_life: '18 months', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 86, name: 'Shringraj', scientific_name: 'Eclipta alba', category: 'Forest Produce / Medicinal', msp: 18.0, unit: 'kg', description: 'Shringraj, also known as Bhringraj, is a medicinal herb used in traditional Indian medicine for its various health benefits, including hair growth promotion and liver disorder treatment. It is an annual plant that grows in marshy places and is widely distributed in India.', season: 'June-September', shelf_life: '1 day', availability_band: 'unknown'});
CREATE (:Material {mfp_id: 87, name: 'Tree Moss', scientific_name: 'Bryophytes', category: 'Forest Produce / Processed', msp: 350.0, unit: 'kg', description: 'Tree Moss, also known as Bryophytes, are small, non-vascular flowerless plants used by tribal people to cure various ailments and have medicinal properties. They are used to make various products like bedding, mattresses, and cushions.', season: '', shelf_life: '', availability_band: 'unknown'});

